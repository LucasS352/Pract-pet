# Copie para .env no servidor. Configure valores reais antes de subir.
MYSQL_ROOT_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
# Use a mesma senha acima codificada para URL nas duas conexões.
DATABASE_URL_HEART=mysql://root:SENHA_CODIFICADA@mysql:3306/heart_practpet
DATABASE_URL_TENANT=mysql://root:SENHA_CODIFICADA@mysql:3306/practpet
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_LONGO
SETUP_PIN=DEFINA_PIN_ADMINISTRATIVO
SQL_PIN=DEFINA_PIN_SQL
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Inicialmente por IP; altere para https://praticpet.teltech.com.br após DNS e TLS.
PUBLIC_APP_URL=http://2.25.136.55:3531
# Origens extras permitidas pelo CORS além da PUBLIC_APP_URL (separadas por vírgula).
CORS_ORIGINS=
# Console SQL no sys-init fica desabilitado em produção por padrão. Só habilite temporariamente se necessário.
ENABLE_SQL_CONSOLE=false
